# Application config. Dev tooling credentials live in .devcontainer/.env.
#
# Locally, everything except the first five is optional. A host needs the whole
# file; see "Run it on a host" in the README.

# --- Required locally -------------------------------------------------------

# Local database. The dev container creates it.
DATABASE_URL=postgresql://evencost:evencost@localhost:5432/evencost

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Who the Terms and Privacy Policy name as the operator. Required, also on a
# host: the build stops without them. Use your own details.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=

# --- Needed on a host -------------------------------------------------------

# Unpooled connection string, used only by migrations. Leave unset locally and
# it falls back to DATABASE_URL. On a host, set it to the direct URL: a
# transaction-mode pooler cannot run migrations.
DIRECT_URL=

# Encryption key for Server Action IDs. Required once more than one instance
# serves traffic; unset locally. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
